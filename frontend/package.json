{
  "name": "chess-by-panchatantra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install && npm install --prefix ../backend",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "kill-api-port": "npm run kill-port-5000 --prefix ../backend",
    "server": "npm run dev --prefix ../backend",
    "client": "vite --host 127.0.0.1 --port 5173",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run"
  },
  "dependencies": {
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^5.15.20",
    "@mui/material": "^5.15.20",
    "axios": "^1.7.2",
    "chess.js": "^1.4.0",
    "concurrently": "^8.2.2",
    "framer-motion": "^11.2.10",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-chessboard": "^5.10.0",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "vite": "^5.3.1",
    "vitest": "^3.0.5"
  }
}
